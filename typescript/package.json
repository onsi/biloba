{
  "name": "biloba",
  "version": "0.16.1",
  "description": "Fast, stable browser testing from TypeScript and Vitest through Biloba",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onsi/biloba.git",
    "directory": "typescript"
  },
  "homepage": "https://onsi.github.io/biloba/vitest.html",
  "bugs": "https://github.com/onsi/biloba/issues",
  "keywords": [
    "browser-testing",
    "chrome",
    "testing",
    "typescript",
    "vitest"
  ],
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "bin": {
    "biloba": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate:protocol": "cd .. && go generate ./protocol",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:parity": "vitest run -c vitest.parity.config.ts",
    "test:e2e": "vitest run -c vitest.e2e.config.ts && vitest run -c vitest.e2e-crash.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {},
  "peerDependencies": {
    "vitest": ">=3 <6"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.8.3",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
